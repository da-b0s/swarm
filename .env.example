# Arc Swarm - copy to .env and fill. NEVER commit .env.
ARC_MAINNET_RPC=https://rpc.mainnet.arc.io
ARC_TESTNET_RPC=https://rpc.testnet.arc.io
ARC_MAINNET_CHAIN_ID=5042
ARC_TESTNET_CHAIN_ID=5042002

# deployer (mainnet). Use an encrypted keystore in preference to a raw key.
DEPLOYER_ADDRESS=
DEPLOYER_KEY=

# EIP-3009 relayer hot wallet - $10 float max
RELAYER_ADDRESS=
RELAYER_KEY=

# deployed addresses (filled after D5 mainnet deploy)
DEAL_FACTORY=
DEMAND_POOL=
SETTLER=
COMMIT_RELAYER=
