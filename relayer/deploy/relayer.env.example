# Copy to relayer.env on the server and fill in. NEVER commit relayer.env.
# The relayer key: the hot wallet that pays gas for fee-free orders and settles deals.
RELAYER_KEY=
RPC_URL=https://rpc.mainnet.arc.io
CHAIN_ID=5042
POOL_ADDRESS=0x7A8754dB7B0d629841523c0694A7788221e9F78f
# The site's exact origin, e.g. https://swarm-xyz.pages.dev (no trailing slash)
ALLOWED_ORIGIN=
# Public HTTPS name for this server. With no domain, use the IP with dashes + .sslip.io,
# e.g. server IP 203.0.113.7 -> 203-0-113-7.sslip.io
RELAYER_HOST=
