diff -ruN a/src/swarm/theme.ts b/src/swarm/theme.ts
--- a/src/swarm/theme.ts	1970-01-01 01:00:00.000000000 +0100
+++ b/src/swarm/theme.ts	2026-10-26 11:45:52.617689500 +0100
@@ -0,0 +1,32 @@
+import { useSyncExternalStore } from 'react'
+
+export type Theme = 'light' | 'dark'
+const KEY = 'swarm-theme'
+
+function initial(): Theme {
+  try {
+    const saved = localStorage.getItem(KEY)
+    if (saved === 'light' || saved === 'dark') return saved
+  } catch { /* storage blocked */ }
+  return window.matchMedia?.('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
+}
+
+let current: Theme = initial()
+const listeners = new Set<() => void>()
+function apply() {
+  document.documentElement.dataset.theme = current
+  document.documentElement.style.colorScheme = current
+}
+apply()
+
+export function toggleTheme() {
+  current = current === 'dark' ? 'light' : 'dark'
+  try { localStorage.setItem(KEY, current) } catch { /* storage blocked */ }
+  apply()
+  listeners.forEach((l) => l())
+}
+
+/** Light/dark preference: follows the system until the user picks one, then remembers it. */
+export function useTheme(): Theme {
+  return useSyncExternalStore((l) => { listeners.add(l); return () => listeners.delete(l) }, () => current)
+}
