78\\t            uint64 settledPrice = paid < cp ? paid : cp;\\n    79\\t            uint64 refund = paid - settledPrice;\\n    80\\t            uint256 supplierContrib = settledPrice;\\n    81\\t\\n    82\\t            claimable[buyers[i]] += refund;\\n    83\\t            totalEscrowed += paid;\\n    84\\t            totalRefunds += refund;\\n    85\\t            totalSupplierCredit += supplierContrib;\\n    86\\t        }\\n    87\\t\\n    88\\t        claimable[deal.supplier] += totalSupplierCredit;\\n    89\\t\\n    90\\t        assert(totalRefunds + totalSupplierCredit == totalEscrowed);\\n    91\\t\\n    92\\t        emit Settled(dealId, cp, uint32(buyers.length));\\n    93\\t    }\\n    94\\t\\n    95\\t    function refundAll(uint256 dealId) external nonReentrant {\\n    96\\t        SwarmTypes.Deal memory deal = factory.getDeal(dealId);\\n    97\\t\\n    98\\t        if (deal.state != 0) revert AlreadySettled();\\n    99\\t        if (block.timestamp < deal.deadline) revert DeadlineNotReached();\\n   100\\t\\n   101\\t        address[] memory buyers = pool.getBuyers(dealId);\\n   102\\t        if (buyers.length >= deal.minBuyers) revert MinBuyersMet();\\n   103\\t\\n   104\\t        factory.setDealState(dealId, 2);\\n   105\\t\\n   106\\t        for (uint256 i = 0; i < buyers.length; i++) {\\n   107\\t            claimable[buyers[i]] += pool.getEscrowed(dealId, buyers[i]);\\n   108\\t        }\\n   109\\t\\n   110\\t        emit Refunded(dealId, uint32(buyers.length));\\n   111\\t    }\\n   112\\t\\n   113\\t    function claim() external nonReentrant {\\n   114\\t        uint256 amount = claimable[msg.sender];\\n   115\\t        if (amount == 0) revert NothingToClaim();\\n   116\\t\\n   117\\t        claimable[msg.sender] = 0;\\n   118\\t        pool.pullForSettler(msg.sender, amount);\\n   119\\t\\n   120\\t        emit Claimed(msg.sender, amount);\\n   121\\t    }\\n   122\\t\\n   123\\t    function transferOwnership(address newOwner) external onlyOwner {\\n   124\\t        if (newOwner == address(0)) revert InvalidAddress();\\n   125\\t        address previousOwner = owner;\\n   126\\t        owner = newOwner;\\n   127\\t        emit OwnershipTransferred(previousOwner, newOwner);\\n   128\\t    }\\n   129\\t}\"}],\"tool_call_id\":\"call_0ZIKuSEbXQD7vJQdrjC44zBK\",\"name\":\"read_file\",\"metadata\":{\"versions\":{\"@langchain/core\":\"1.2.12\"}},\"additional_kwargs\":{},\"response_metadata\":{}}}"}}
