n   133\\t        if (buyerPos == 0) revert NotCommitted();\\n   134\\t\\n   135\\t        uint64 priceBefore = clearingPrice(dealId);\\n   136\\t\\n   137\\t        uint256 idx = buyerPos - 1;\\n   138\\t        uint256 lastIndex = _buyers[dealId].length - 1;\\n   139\\t        address last = _buyers[dealId][lastIndex];\\n   140\\t\\n   141\\t        _buyers[dealId][idx] = last;\\n   142\\t        _buyerIndex[dealId][last] = idx + 1;\\n   143\\t        _buyers[dealId].pop();\\n   144\\t\\n   145\\t        delete _buyerIndex[dealId][msg.sender];\\n   146\\t\\n   147\\t        uint64 priceAfter = clearingPrice(dealId);\\n   148\\t        if (priceAfter != priceBefore) {\\n   149\\t            emit TierBroken(dealId, uint32(_buyers[dealId].length), priceAfter);\\n   150\\t        }\\n   151\\t\\n   152\\t        ISettler(settler).creditWithdrawal(msg.sender, collateral[dealId]);\\n   153\\t\\n   154\\t        emit Withdrawn(dealId, msg.sender, priceAfter, uint32(_buyers[dealId].length));\\n   155\\t    }\\n   156\\t\\n   157\\t    function pullForSettler(address to, uint256 amount) external nonReentrant {\\n   158\\t        if (msg.sender != settler) revert Unauthorized();\\n   159\\t        bool ok = USDC.transfer(to, amount);\\n   160\\t        if (!ok) revert TransferFailed();\\n   161\\t    }\\n   162\\t\\n   163\\t    function getBuyers(uint256 dealId) external view returns (address[] memory) {\\n   164\\t        return _buyers[dealId];\\n   165\\t    }\\n   166\\t\\n   167\\t    function getBuyerCount(uint256 dealId) external view returns (uint32) {\\n   168\\t        return uint32(_buyers[dealId].length);\\n   169\\t    }\\n   170\\t\\n   171\\t    function transferOwnership(address newOwner) external onlyOwner {\\n   172\\t        if (newOwner == address(0)) revert InvalidAddress();\\n   173\\t        address previousOwner = owner;\\n   174\\t        owner = newOwner;\\n   175\\t        emit OwnershipTransferred(previousOwner, newOwner);\\n   176\\t    }\\n   